# Copia este archivo como .env en el servidor y llena los valores (NUNCA lo subas a git)
META_TOKEN_ANYTIME=
META_TOKEN_GARKENRECLU=
# Gmail / Google Workspace: cuenta que envía y su "contraseña de aplicación" (no la contraseña normal)
MAIL_USER=
MAIL_PASS=
# Destinatarios del correo semanal, separados por coma
MAIL_TO=
# Correo para dudas que aparece en el pie del mensaje (opcional)
MAIL_CONTACTO=
